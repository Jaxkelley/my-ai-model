 
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My AI Chat</title>
<style>
* { box-sizing: border-box; }
body {
      margin: 0;
        background: #10101a;
          color: #f4f0ff;
            font-family: Arial, sans-serif;
              height: 100dvh;
                display: flex;
}
.sidebar {
      width: 240px;
        background: #191827;
          padding: 16px;
            display: flex;
              flex-direction: column;
                gap: 12px;
}
h2 { margin: 5px 0 15px; }
button {
      background: #7048d8;
        color: white;
          border: 0;
            border-radius: 10px;
              padding: 12px;
                cursor: pointer;
}
button:hover { background: #805be8; }
#history {
      overflow-y: auto;
        display: flex;
          flex-direction: column;
            gap: 7px;
}
.history-item {
      background: #29263a;
        text-align: left;
          overflow: hidden;
}
.main {
      flex: 1;
        min-width: 0;
          display: flex;
            flex-direction: column;
}
header {
      padding: 18px;
        border-bottom: 1px solid #302c42;
          font-weight: bold;
}
#messages {
      flex: 1;
        overflow-y: auto;
          padding: 20px;
            display: flex;
              flex-direction: column;
                gap: 14px;
}
.message {
      padding: 13px 16px;
        border-radius: 14px;
          max-width: 85%;
            line-height: 1.5;
              white-space: pre-wrap;
                overflow-wrap: anywhere;
}
.user {
      background: #6845bd;
        align-self: flex-end;
}
.assistant {
      background: #272538;
        align-self: flex-start;
}
.composer {
      display: flex;
        gap: 10px;
          padding: 15px;
            border-top: 1px solid #302c42;
}
textarea {
      flex: 1;
        min-width: 0;
          resize: none;
            border: 1px solid #45405b;
              border-radius: 12px;
                background: #201e30;
                  color: white;
                    padding: 13px;
                      font: inherit;
}
@media(max-width:600px) {
      .sidebar { width: 115px; padding: 8px; }
        .sidebar h2 { font-size: 16px; }
          .message { max-width: 95%; }
            .composer { padding: 9px; }
}
</style>
</head>
<body>
<aside class="sidebar">
  <h2>My AI Chat</h2>
    <button onclick="newChat()">+ New Chat</button>
      <div id="history"></div>
      </aside>

      <main class="main">
        <header>My AI Assistant</header>
          <div id="messages">
              <div class="message assistant">
                    Welcome! This is your personal AI chat app prototype. Your conversations are saved on this device.
                        </div>
                          </div>
                            <div class="composer">
                                <textarea id="input" rows="2" placeholder="Message your AI..."></textarea>
                                    <button onclick="sendMessage()">Send</button>
                                      </div>
                                      </main>

                                      <script>
                                      let chats = JSON.parse(localStorage.getItem("myChats") || "[]");
                                      let currentChat = null;

                                      function save() {
                                          localStorage.setItem("myChats", JSON.stringify(chats));
                                      }

                                      function newChat() {
                                          currentChat = {
                                                id: Date.now(),
                                                    title: "New conversation",
                                                        messages: []
                                          };
                                            chats.unshift(currentChat);
                                              save();
                                                render();
                                      }

                                      function render() {
                                          const area = document.getElementById("messages");
                                            area.innerHTML = "";

                                              if (!currentChat) {
                                                    area.innerHTML = '<div class="message assistant">Start a new conversation to begin.</div>';
                                              } else {
                                                    currentChat.messages.forEach(m => {
                                                              const div = document.createElement("div");
                                                                    div.className = "message " + m.role;
                                                                          div.textContent = m.text;
                                                                                area.appendChild(div);
                                                    });
                                              }

                                                const history = document.getElementById("history");
                                                  history.innerHTML = "";
                                                    chats.forEach(chat => {
                                                            const btn = document.createElement("button");
                                                                btn.className = "history-item";
                                                                    btn.textContent = chat.title;
                                                                        btn.onclick = () => {
                                                                                  currentChat = chat;
                                                                                        render();
                                                                        };
                                                                            history.appendChild(btn);
                                                    });

                                                      area.scrollTop = area.scrollHeight;
                                      }

                                      function sendMessage() {
                                          const input = document.getElementById("input");
                                            const text = input.value.trim();
                                              if (!text) return;

                                                if (!currentChat) newChat();

                                                  currentChat.messages.push({role: "user", text});

                                                    if (currentChat.messages.length === 1) {
                                                            currentChat.title = text.slice(0, 28);
                                                    }

                                                      currentChat.messages.push({
                                                            role: "assistant",
                                                                text: "Your message has been saved! The AI engine isn't connected yet. That's our next development step."
                                                      });

                                                        input.value = "";
                                                          save();
                                                            render();
                                      }

                                      document.getElementById("input").addEventListener("keydown", e => {
                                          if (e.key === "Enter" && !e.shiftKey) {
                                                e.preventDefault();
                                                    sendMessage();
                                          }
                                      });

                                      render();
                                      </script>
                                      </body>
                                      </html>
                                      
                                                    })
                                          }
}